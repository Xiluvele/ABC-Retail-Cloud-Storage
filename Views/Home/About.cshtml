@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="text-center mb-5">

                <h1 class="fw-bold">
                    About ABC Retail
                </h1>

                <p class="lead text-muted">
                    Building a more scalable and reliable retail platform
                    with Microsoft Azure.
                </p>

            </div>

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-md-5">

                    <h3 class="mb-3">
                        Who We Are
                    </h3>

                    <p>
                        ABC Retail is a growing online retailer that manages
                        customer orders, products, inventory and digital
                        product content.
                    </p>

                    <p>
                        As the business grows, traditional on-premises
                        infrastructure can struggle to handle increasing
                        transaction volumes, storage requirements and
                        real-time processing demands.
                    </p>

                    <h3 class="mt-5 mb-3">
                        Our Cloud Solution
                    </h3>

                    <p>
                        This application demonstrates how Microsoft Azure
                        Storage Services can be used to improve the
                        scalability, availability and management of ABC
                        Retail's data and operational processes.
                    </p>

                    <div class="row g-4 mt-2">

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Azure Table Storage
                                </h5>

                                <p class="text-muted mb-0">
                                    Stores customer profiles and product
                                    information in a scalable NoSQL data store.
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Azure Blob Storage
                                </h5>

                                <p class="text-muted mb-0">
                                    Stores product images and multimedia
                                    content efficiently in the cloud.
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Azure Queue Storage
                                </h5>

                                <p class="text-muted mb-0">
                                    Supports reliable asynchronous processing
                                    of customer orders and inventory operations.
                                </p>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Azure Files
                                </h5>

                                <p class="text-muted mb-0">
                                    Provides cloud-based file storage for
                                    application and transaction logs.
                                </p>

                            </div>

                        </div>

                    </div>

                    <h3 class="mt-5 mb-3">
                        Project Objective
                    </h3>

                    <p class="mb-0">
                        The objective of this solution is to demonstrate how
                        cloud storage technologies can reduce reliance on
                        traditional infrastructure while supporting a growing
                        retail business with scalable and reliable services.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>