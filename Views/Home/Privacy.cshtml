@{
    ViewData["Title"] = "Privacy";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="mb-5">

                <h1 class="fw-bold">
                    Privacy Policy
                </h1>

                <p class="text-muted">
                    How information is handled within the ABC Retail
                    Azure Storage application.
                </p>

            </div>

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">

                    <h4>
                        Customer Information
                    </h4>

                    <p>
                        Customer profile information entered into this
                        application is stored using Microsoft Azure Table
                        Storage.
                    </p>

                    <p>
                        The application only collects information required
                        to demonstrate customer management functionality,
                        such as names, contact information and addresses.
                    </p>

                    <hr class="my-4" />

                    <h4>
                        Product Information and Images
                    </h4>

                    <p>
                        Product details are stored using Azure Table Storage,
                        while product images are stored separately in Azure
                        Blob Storage.
                    </p>

                    <p>
                        Blob containers are configured to prevent anonymous
                        access. Temporary authorized URLs may be generated
                        when images need to be displayed within the
                        application.
                    </p>

                    <hr class="my-4" />

                    <h4>
                        Order and Inventory Data
                    </h4>

                    <p>
                        Order and inventory processing messages are stored
                        using Azure Queue Storage to demonstrate reliable
                        asynchronous processing.
                    </p>

                    <hr class="my-4" />

                    <h4>
                        Application Logs
                    </h4>

                    <p>
                        Application and transaction log files are stored
                        using Azure Files for demonstration and operational
                        record purposes.
                    </p>

                    <hr class="my-4" />

                    <h4>
                        Security
                    </h4>

                    <p>
                        Azure Storage credentials are not stored directly
                        inside the application source code. Development
                        credentials are managed using secure configuration,
                        and production credentials are configured through
                        Azure App Service settings.
                    </p>

                    <p class="mb-0">
                        This application has been developed for educational
                        and demonstration purposes as part of the ABC Retail
                        cloud storage solution.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>