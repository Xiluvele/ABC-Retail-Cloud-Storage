@model ABCRetail.ViewModels.InventoryViewModel

@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2>Inventory Management</h2>

                    <p class="text-muted">
                        Submit inventory transactions to Azure Queue Storage.
                    </p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="Index" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label asp-for="ProductName" class="form-label"> </label>

                            <select asp-for="ProductName"
                                    asp-items="Model.Products"
                                    class="form-select">

                                <option value="">-- Select Product --</option>

                            </select>


                            <span asp-validation-for="ProductName" class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Operation"class="form-label"> Operation</label>

                            <select asp-for="Operation" class="form-select">

                                <option value=""> -- Select Operation --</option>

                                <option value="Restock">Restock</option>

                                <option value="StockReduction">Stock Reduction</option>

                                <option value="StockAdjustment"> Stock Adjustment</option>

                            </select>

                            <span asp-validation-for="Operation" class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Quantity" class="form-label"> </label>
                            <input asp-for="Quantity" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"> </span>

                        </div>

                        <button type="submit" class="btn btn-primary"> Submit Inventory Transaction</button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}